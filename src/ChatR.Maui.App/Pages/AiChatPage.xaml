<?xml version="1.0" encoding="utf-8" ?>
<ContentPageBase
    x:TypeArguments="AiChatPageViewModel"
    x:Class="ChatR.Maui.App.Pages.AiChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ChatR.Maui.App.Infrastructure.Converters"
    Title="AI Chat">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <Picker
            Grid.Row="0"
            Margin="8,8,8,0"
            Title="AI provider"
            ItemsSource="{Binding Providers}"
            ItemDisplayBinding="{Binding DisplayName}"
            SelectedItem="{Binding SelectedProvider}" />

        <!-- Shown when the selected AI provider isn't configured -->
        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding IsAvailable, Converter={StaticResource InvertedBoolConverter}}"
            Padding="24"
            Spacing="12"
            VerticalOptions="Center">
            <Label
                Text="AI chat isn't configured yet"
                FontSize="20"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />
            <Label
                Text="{Binding UnavailableReason}"
                FontSize="13"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                TextColor="{AppThemeBinding Light=#666, Dark=#aaa}" />
        </VerticalStackLayout>

        <!-- Chat UI, shown once the selected provider is available -->
        <Grid
            Grid.Row="1"
            IsVisible="{Binding IsAvailable}"
            RowDefinitions="*,Auto">
            <CollectionView
                x:Name="MessagesCollectionView"
                ItemsSource="{Binding Messages}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="ChatMessage">
                        <VerticalStackLayout Padding="12,6">
                            <Label
                                Text="{Binding Sender}"
                                FontAttributes="Bold"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light=#555, Dark=#aaa}" />
                            <Label Text="{Binding Text}" FontSize="16" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid
                Grid.Row="1"
                Padding="12,4,12,8"
                IsVisible="{Binding IsAwaitingAiResponse}">
                <Border
                    StrokeThickness="0"
                    Background="{AppThemeBinding Light=#eef3ff, Dark=#273246}"
                    StrokeShape="RoundRectangle 14"
                    Padding="10,6">
                    <HorizontalStackLayout Spacing="8">
                        <ActivityIndicator
                            IsRunning="{Binding IsAwaitingAiResponse}"
                            VerticalOptions="Center" />
                        <Label
                            Text="AI is responding..."
                            FontSize="13"
                            VerticalOptions="Center"
                            TextColor="{AppThemeBinding Light=#30436b, Dark=#cdd9f5}" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="2"
            IsVisible="{Binding IsAvailable}"
            ColumnDefinitions="*,Auto"
            Padding="8"
            ColumnSpacing="8">
            <Entry
                Grid.Column="0"
                Placeholder="Ask the AI..."
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                Text="{Binding MessageText}"
                ReturnCommand="{Binding SendMessageCommand}" />
            <Button
                Grid.Column="1"
                Text="Send"
                Command="{Binding SendMessageCommand}" />
        </Grid>

    </Grid>

</ContentPageBase>
