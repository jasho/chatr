<?xml version="1.0" encoding="utf-8" ?>
<ContentPageBase
    x:TypeArguments="SettingsPageViewModel"
    x:Class="ChatR.Maui.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Settings">

    <VerticalStackLayout
        Padding="30"
        Spacing="16"
        VerticalOptions="Center">
        <Label
            Text="Settings"
            HorizontalOptions="Center"
            FontSize="24" />
        <Label Text="User name" />
        <Entry
            Placeholder="Enter your name"
            Text="{Binding UserName}" />
        <Label Text="Theme" Margin="0,16,0,0" />
        <Picker
            ItemsSource="{Binding ThemeOptions}"
            SelectedItem="{Binding SelectedTheme}" />

        <HorizontalStackLayout Spacing="12" Margin="0,16,0,0">
            <Label Text="Enable AI in Chat" VerticalOptions="Center" />
            <Switch IsToggled="{Binding IsAiChatEnabled}" />
        </HorizontalStackLayout>

        <Button
            Text="Save"
            Command="{Binding SaveSettingsCommand}"
            Margin="0,16,0,0" />
    </VerticalStackLayout>

</ContentPageBase>
