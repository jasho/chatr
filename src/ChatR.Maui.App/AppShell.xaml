<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ChatR.Maui.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="ChatR">

    <ShellContent
        Title="Chat"
        ContentTemplate="{DataTemplate ChatPage}"
        Route="chat" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate MainPage}"
        Route="main" />

    <ShellContent
        Title="Settings"
        ContentTemplate="{DataTemplate SettingsPage}"
        Route="settings" />

</Shell>
